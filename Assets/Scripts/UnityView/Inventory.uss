.inventory-root {
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    background-color: rgba(18, 20, 24, 0.95);
    padding: 24px;
}

.inventory-card {
    width: 440px;
    background-color: #1f242d;
    border-radius: 12px;
    border-width: 1px;
    border-color: #343c4a;
    padding: 20px;
    align-items: stretch;
}

.inventory-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: #ffffff;
    -unity-text-align: middle-center;
    margin-bottom: 2px;
}

.inventory-subtitle {
    font-size: 12px;
    color: #8c9ba5;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}

.error-banner {
    background-color: rgba(220, 53, 69, 0.2);
    border-color: #dc3545;
    border-width: 1px;
    border-radius: 6px;
    color: #ff6b6b;
    font-size: 13px;
    -unity-font-style: bold;
    padding: 8px 12px;
    margin-bottom: 14px;
    -unity-text-align: middle-center;
}

.slots-container {
    flex-direction: column;
    margin-bottom: 18px;
}

.slot-box {
    background-color: #161a22;
    border-color: #2b3340;
    border-width: 1px;
    border-radius: 6px;
    padding: 10px 14px;
    margin-bottom: 8px;
    justify-content: center;
}

.slot-label {
    font-size: 14px;
    color: #d1d7e0;
}

.actions-container {
    align-items: stretch;
    margin-top: 4px;
}

.btn-primary {
    background-color: #238636;
    border-color: #2ea043;
    border-width: 1px;
    border-radius: 6px;
    color: #ffffff;
    font-size: 14px;
    -unity-font-style: bold;
    padding: 10px 16px;
    cursor: link;
    transition-property: background-color;
    transition-duration: 0.15s;
}

.btn-primary:hover {
    background-color: #2ea043;
}

.btn-primary:active {
    background-color: #1b6528;
}

