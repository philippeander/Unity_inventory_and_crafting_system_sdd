<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="Inventory.uss" />
    <ui:VisualElement class="inventory-root">
        <ui:VisualElement class="inventory-card">
            <!-- Header -->
            <ui:Label text="Advanced Inventory" class="inventory-title" />
            <ui:Label text="Clean Architecture &amp; UI Toolkit Demo" class="inventory-subtitle" />

            <!-- Error Banner -->
            <ui:Label name="lblError" text="" class="error-banner" style="display: none;" />

            <!-- Slots Grid -->
            <ui:VisualElement class="slots-container">
                <ui:VisualElement class="slot-box">
                    <ui:Label name="slot-label-0" text="Slot 0: [Empty]" class="slot-label" />
                </ui:VisualElement>
                <ui:VisualElement class="slot-box">
                    <ui:Label name="slot-label-1" text="Slot 1: [Empty]" class="slot-label" />
                </ui:VisualElement>
                <ui:VisualElement class="slot-box">
                    <ui:Label name="slot-label-2" text="Slot 2: [Empty]" class="slot-label" />
                </ui:VisualElement>
                <ui:VisualElement class="slot-box">
                    <ui:Label name="slot-label-3" text="Slot 3: [Empty]" class="slot-label" />
                </ui:VisualElement>
                <ui:VisualElement class="slot-box">
                    <ui:Label name="slot-label-4" text="Slot 4: [Empty]" class="slot-label" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Actions -->
            <ui:VisualElement class="actions-container">
                <ui:Button name="btnAddPotion" text="Add Health Potion (5x)" class="btn-primary" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

